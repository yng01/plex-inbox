# ── Required ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ── Video files of any size (optional) ──────────────────────────────────────
# By default the bot talks straight to api.telegram.org, which caps files a
# bot can RECEIVE at 20 MB. To lift that cap, run a local Bot API Server:
#   1. Get a free one-time API ID/Hash: https://my.telegram.org
#      -> "API development tools" (needs your Telegram phone number).
#   2. Fill in the values below.
#   3. Start with:  docker compose --profile local-api up -d --build bot
# (In default mode these can stay empty.)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Point the bot at the local server (compose service name: bot-api).
TELEGRAM_BOT_API_BASE_URL=http://bot-api:8081
TELEGRAM_BOT_API_BASE_FILE_URL=http://bot-api:8081/file

# ── Access ──────────────────────────────────────────────────────────────────
# Who may use the bot:
#   all | *            → open to anyone who finds it
#   123456789,987654   → only these numeric Telegram user IDs (comma-separated)
ALLOWED_USER_IDS=all

# If a not-allowed user talks to the bot: reply with their numeric ID (1) so
# you can add them to ALLOWED_USER_IDS, or stay silent (0).
DEBUG_ACCESS=0

# ── Storage & downloads ─────────────────────────────────────────────────────
# Where the library lives on disk (bind-mounted from ./data in compose)
DATA_DIR=/data

# Max parallel downloads; extras wait in a queue you can view/cancel
MAX_CONCURRENT=2

# 1 = embed every audio track as separate streams (MKV) so you can switch
#     audio in Plex; 0 = best single video+audio (MP4)
MULTI_AUDIO=1

# Optional yt-dlp format override (e.g. "137+140" or "bv*+ba/b").
# When set, wins over MULTI_AUDIO.
#VIDEO_FORMAT=

# ── Maintenance ─────────────────────────────────────────────────────────────
# 1 = auto-upgrade yt-dlp from PyPI when a newer release appears; 0 = pin image version
AUTO_UPDATE=1
# At most one PyPI check per N hours (also runs once at startup)
UPDATE_CHECK_HOURS=24

# 1 = write Kodi/Plex NFO + sidecar JSON per video; 0 = skip metadata
WRITE_NFO=1

# Base language before the user picks one (en | ar)
DEFAULT_LANG=en

# ── Plex (all optional) ─────────────────────────────────────────────────────
# When both are set, the bot pings Plex after each finished download so the
# new file shows up immediately. Failures are logged and ignored.
PLEX_URL=
PLEX_TOKEN=
